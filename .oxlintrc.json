{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react"],
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "apps/web/app/features/graph/canvas-renderer.ts"
      ],
      "rules": {
        "typescript/unbound-method": "off"
      }
    }
  ]
}
