{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run",
      "type": "shell",
      "command": "go tool packer run",
      "options": {
        "cwd": "${workspaceFolder}/source",
        "env": { "GOWORK": "off" }
      }
    },
    {
      "label": "build",
      "type": "shell",
      "command": "go tool packer build",
      "options": {
        "cwd": "${workspaceFolder}/source",
        "env": { "GOWORK": "off" }
      }
    }
  ]
}
