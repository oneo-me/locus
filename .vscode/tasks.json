{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run",
      "type": "shell",
      "command": "go tool mygo dev",
      "options": {
        "cwd": "${workspaceFolder}/source",
        "env": { "GOWORK": "off" }
      }
    },
    {
      "label": "build",
      "type": "shell",
      "command": "go tool mygo build -platform darwin/arm64,darwin/amd64,windows/amd64,windows/arm64,linux/amd64,linux/arm64",
      "options": {
        "cwd": "${workspaceFolder}/source",
        "env": { "GOWORK": "off" }
      }
    }
  ]
}
