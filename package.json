{
  "name": "locus-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @locus/server --filter @locus/web dev",
    "dev:server": "pnpm --filter @locus/server dev",
    "dev:web": "pnpm --filter @locus/web dev",
    "build": "tsx scripts/build.ts",
    "deploy": "tsx scripts/deploy.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc -p tsconfig.scripts.json && pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.9",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.20.0"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
